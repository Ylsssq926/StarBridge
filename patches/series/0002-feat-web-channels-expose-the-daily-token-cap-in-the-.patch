 11 files changed, 66 insertions(+), 1 deletion(-)

diff --git a/web/src/features/channels/components/drawers/channel-mutate-drawer.tsx b/web/src/features/channels/components/drawers/channel-mutate-drawer.tsx
index 2b588ba7d..75e25d9d8 100644
--- a/web/src/features/channels/components/drawers/channel-mutate-drawer.tsx
+++ b/web/src/features/channels/components/drawers/channel-mutate-drawer.tsx
@@ -298,6 +298,7 @@ const SENSITIVE_FORM_FIELDS = [
   'azure_responses_version',
   'force_format',
   'thinking_to_content',
+  'daily_token_limit',
   'proxy',
   'http_protocol',
   'http2_connection_shards',
@@ -1797,6 +1798,37 @@ export function ChannelMutateDrawer({
     [onOpenChange, form, isSubmitting, showProviderPicker, providerTarget]
   )
 
+  const dailyTokenLimitFields = (
+    <FormField
+      control={form.control}
+      name='daily_token_limit'
+      render={({ field }) => (
+        <FormItem>
+          <FormLabel>{t('Daily Token Limit')}</FormLabel>
+          <FormControl>
+            <Input
+              type='number'
+              min={0}
+              step={1}
+              placeholder={t('0 means unlimited')}
+              {...field}
+              value={field.value ?? 0}
+              onChange={(event) =>
+                field.onChange(Number(event.target.value) || 0)
+              }
+            />
+          </FormControl>
+          <FormDescription>
+            {t(
+              'Maximum billable input + output tokens per channel per day. 0 means unlimited.'
+            )}
+          </FormDescription>
+          <FormMessage />
+        </FormItem>
+      )}
+    />
+  )
+
   const proxyFields = (
     <FormField
       control={form.control}
@@ -4787,6 +4819,7 @@ export function ChannelMutateDrawer({
                 className='space-y-4 disabled:opacity-60'
               >
                 {taskPollingFields}
+                {dailyTokenLimitFields}
                 {proxyFields}
                 {httpProtocolFields}
                 {httpShardsFields}
