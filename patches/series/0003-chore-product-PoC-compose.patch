--- /dev/null
+++ b/scripts/product.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+COMPOSE_ENV="${COMPOSE_ENV:-.env}"
+COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.poc.yml}"
+
+require_env() {
+  if [ ! -f "$COMPOSE_ENV" ]; then
+    echo "missing $COMPOSE_ENV; run: cp .env.product.example .env" >&2
+    exit 1
+  fi
+  if grep -q 'change-me' "$COMPOSE_ENV"; then
+    echo "WARNING: $COMPOSE_ENV still contains change-me secrets" >&2
+  fi
+}
+
+usage() {
+  cat >&2 <<'EOF'
+usage: ./scripts/product.sh <command>
+
+  image    build the patched product image
+  up       start the compose stack (uses .env)
+  down     stop the compose stack
+  ps       show compose status
+  logs     follow new-api logs
+  status   show upstream sync status
+  check    quick backend/patch checks (reuse web/dist)
+  check-full  build frontend + typecheck + backend checks
+EOF
+  exit 2
+}
+
+case "${1:-}" in
+  image) ./scripts/build-image.sh ;;
+  up) require_env; docker compose --env-file "$COMPOSE_ENV" -f "$COMPOSE_FILE" up -d ;;
+  down) require_env; docker compose --env-file "$COMPOSE_ENV" -f "$COMPOSE_FILE" down ;;
+  ps) require_env; docker compose --env-file "$COMPOSE_ENV" -f "$COMPOSE_FILE" ps ;;
+  logs) require_env; docker compose --env-file "$COMPOSE_ENV" -f "$COMPOSE_FILE" logs -f new-api ;;
+  status) ./scripts/upstream-sync.sh status ;;
+  check) ./scripts/upstream-sync.sh check ;;
+  check-full) ./scripts/upstream-sync.sh check-full ;;
+  *) usage ;;
+esac
diff --git a/scripts/upstream-sync.sh b/scripts/upstream-sync.sh
new file mode 100644
index 000000000..bf6349632
--- /dev/null
+++ b/scripts/upstream-sync.sh
@@ -0,0 +1,271 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+UPSTREAM_REMOTE="${UPSTREAM_REMOTE:-upstream}"
+UPSTREAM_BRANCH="${UPSTREAM_BRANCH:-main}"
+UPSTREAM_URL="${UPSTREAM_URL:-https://github.com/QuantumNous/new-api.git}"
+PATCH_DIR="${PATCH_DIR:-patches}"
+PATCH_FILE="${PATCH_FILE:-$PATCH_DIR/channel-daily-limit.patch}"
+# main-based series by default. For rc.46 use:
+#   PATCH_FILES="patches/channel-daily-limit.patch" ./scripts/upstream-sync.sh apply v1.0.0-rc.46
+PATCH_FILES="${PATCH_FILES:-$PATCH_DIR/0001-daily-limit-core.patch $PATCH_DIR/0002-daily-limit-web.patch $PATCH_DIR/0003-console-block-adaptation.patch}"
+WORKTREE_ROOT="${WORKTREE_ROOT:-$(dirname "$ROOT")}"
+
+ensure_remote() {
+  if ! git remote get-url "$UPSTREAM_REMOTE" >/dev/null 2>&1; then
+    git remote add "$UPSTREAM_REMOTE" "$UPSTREAM_URL"
+  fi
+  git fetch "$UPSTREAM_REMOTE" \
+    "+refs/heads/$UPSTREAM_BRANCH:refs/remotes/$UPSTREAM_REMOTE/$UPSTREAM_BRANCH" \
+    --tags --prune
+}
+
+cmd_status() {
+  ensure_remote
+  local upstream_ref="$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
+  echo "HEAD: $(git rev-parse --short HEAD) $(git log -1 --format=%ad --date=short)"
+  if git rev-parse --verify --quiet "$upstream_ref" >/dev/null; then
+    echo "Upstream: $upstream_ref $(git rev-parse --short "$upstream_ref")"
+    echo "Behind upstream: $(git rev-list --count "HEAD..$upstream_ref" 2>/dev/null || echo "n/a") commits"
+    echo "Custom commits: $(git rev-list --count "$upstream_ref..HEAD" 2>/dev/null || echo "n/a")"
+  else
+    echo "Upstream: $upstream_ref (not fetched)"
+  fi
+  if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = "true" ]; then
+    echo "(shallow clone: commit counts may be incomplete; run git fetch --unshallow)"
+  fi
+  echo "--- working tree ---"
+  git diff --stat
+  echo "--- untracked ---"
+  git status --short | grep '^??' || true
+}
+
+# The guard is fail-closed: every change must be in the patch unless it is part
+# of the product layer or a build artifact listed here.
+FUNCTIONAL_DIRS="${FUNCTIONAL_DIRS:-common constant dto i18n model relaykit service web/src}"
+
+# Product layer copied into a new worktree on upgrade. `docs/` is upstream-owned,
+# so only these files are copied; `scripts/` and `patches/` do not exist upstream.
+TOOLING_FILES="${TOOLING_FILES:-PRODUCT.md PRODUCT_VERSION Dockerfile.product Makefile.product .env.product.example docker-compose.poc.yml docs/ITERATION_PLAN.md docs/UPSTREAM_SYNC.md docs/PROVIDER_MATRIX.md docs/VERIFICATION.md docs/OPERATIONS.md}"
+TOOLING_DIRS="${TOOLING_DIRS:-scripts patches}"
+# Build output that must never be part of a source patch.
+ARTIFACT_DIRS="${ARTIFACT_DIRS:-bin data logs web/dist web/node_modules}"
+
+is_product_layer_path() {
+  local path="$1" item
+  for item in $TOOLING_FILES; do
+    [ "$path" = "$item" ] && return 0
+  done
+  for item in $TOOLING_DIRS $ARTIFACT_DIRS; do
+    case "$path" in
+      "$item"/*) return 0 ;;
+    esac
+  done
+  return 1
+}
+
+is_functional_path() {
+  # Fail closed: anything that is neither product layer nor build artifact has
+  # to be represented in the source patch, including tracked root files such as
+  # .gitignore.
+  local path="$1"
+  is_product_layer_path "$path" && return 1
+  return 0
+}
+
+# Intent-to-add every untracked non-product file, so an added file can never be
+# silently left out of the patch (the previous hardcoded list could rot).
+stage_functional_untracked() {
+  local path
+  while IFS= read -r path; do
+    [ -n "$path" ] || continue
+    if is_functional_path "$path"; then
+      git add -N "$path"
+    fi
+  done < <(git status --porcelain | sed -n 's/^?? //p')
+}
+
+working_tree_functional_files() {
+  # Read-only on purpose: untracked paths are listed straight from status, so a
+  # verification run never mutates the index (only cmd_export stages).
+  {
+    git diff --name-only HEAD
+    git status --porcelain | sed -n 's/^?? //p'
+  } | sort -u | while IFS= read -r path; do
+    [ -n "$path" ] || continue
+    is_functional_path "$path" && echo "$path"
+  done
+}
+
+patch_files() {
+  grep -E '^diff --git a/' "$1" | sed -E 's|^diff --git a/[^ ]+ b/||'
+}
+
+cmd_verify_patch() {
+  local file="${1:-$PATCH_FILE}"
+  if [ ! -f "$file" ]; then
+    echo "missing patch: $file" >&2
+    return 1
+  fi
+  local missing="" extra="" covered tree
+  covered="$(patch_files "$file" | sort -u)"
+  tree="$(working_tree_functional_files)"
+  while IFS= read -r path; do
+    [ -n "$path" ] || continue
+    if ! echo "$covered" | grep -qxF "$path"; then
+      missing="$missing $path"
+    fi
+  done <<< "$tree"
+  while IFS= read -r path; do
+    [ -n "$path" ] || continue
+    is_functional_path "$path" || continue
+    if ! echo "$tree" | grep -qxF "$path"; then
+      extra="$extra $path"
+    fi
+  done <<< "$covered"
+  echo "patch: $file"
+  echo "functional files covered: $(echo "$covered" | grep -c . )"
+  if [ -n "$missing" ]; then
+    echo "NOT COVERED by patch:$missing" >&2
+    return 1
+  fi
+  if [ -n "$extra" ]; then
+    echo "patch contains files with no working-tree change:$extra" >&2
+    return 1
+  fi
+  echo "verify-patch: OK (working tree == patch)"
+}
+
+cmd_tooling() {
+  local dir="${1:-}"
+  if [ -z "$dir" ]; then
+    echo "usage: $0 tooling <worktree-dir>" >&2
+    exit 2
+  fi
+  if [ ! -d "$dir" ]; then
+    echo "not a directory: $dir" >&2
+    return 1
+  fi
+  local item
+  for item in $TOOLING_FILES; do
+    if [ ! -f "$ROOT/$item" ]; then
+      echo "skip missing: $item" >&2
+      continue
+    fi
+    mkdir -p "$(dirname "$dir/$item")"
+    cp "$ROOT/$item" "$dir/$item"
+    echo "copied: $item"
+  done
+  for item in $TOOLING_DIRS; do
+    if [ ! -d "$ROOT/$item" ]; then
+      echo "skip missing: $item" >&2
+      continue
+    fi
+    if [ -e "$dir/$item" ]; then
+      echo "refusing to overwrite existing $dir/$item (copy manually)" >&2
+      continue
+    fi
+    cp -R "$ROOT/$item" "$dir/$item"
+    echo "copied: $item/"
+  done
+}
+
+cmd_export() {
+  mkdir -p "$PATCH_DIR"
+  stage_functional_untracked
+  git diff --binary HEAD > "$PATCH_FILE"
+  echo "wrote $PATCH_FILE"
+  git apply --stat "$PATCH_FILE" | tail -3
+  cmd_verify_patch "$PATCH_FILE"
+}
+
+cmd_check() {
+  local dir="${1:-$ROOT}"
+  (
+    cd "$dir"
+    if [ ! -f web/dist/index.html ]; then
+      if [ -f "$ROOT/web/dist/index.html" ]; then
+        echo "==> copying web/dist from $ROOT"
+        mkdir -p web/dist
+        cp -R "$ROOT/web/dist/." web/dist/
+      else
+        echo "==> web/dist missing, building frontend"
+        (cd web && bun install --frozen-lockfile && bun run build)
+      fi
+    fi
+    go build ./...
+    (cd relaykit && GOWORK=off go build ./...)
+    go test ./common -run Daily -count=1
+    go test ./model -run 'Daily|FilterCandidate|TaskPlugin' -count=1
+    go test ./service -run 'TestSettle_|TestTaskBilling|TestLogTaskConsumption|TestRecalculate' -count=1
+    if [ "${SKIP_TYPECHECK:-0}" = "1" ]; then
+      echo "==> skip typecheck (SKIP_TYPECHECK=1)"
+    elif [ -e web/node_modules/.bin/tsgo ]; then
+      (cd web && bun run typecheck)
+    else
+      echo "==> skip typecheck: tsgo missing (run bun install first)"
+    fi
+  )
+}
+
+cmd_check_full() {
+  local dir="${1:-$ROOT}"
+  (
+    cd "$dir/web"
+    bun install --frozen-lockfile
+    bun run build
+    bun run typecheck
+  )
+  # Frontend is verified above; keep backend checks without a second typecheck.
+  SKIP_TYPECHECK=1 cmd_check "$dir"
+}
+
+cmd_apply() {
+  local tag="${1:-}"
+  if [ -z "$tag" ]; then
+    echo "usage: $0 apply <tag>" >&2
+    exit 2
+  fi
+  ensure_remote
+  local target="$WORKTREE_ROOT/new-api-$tag"
+  if [ -e "$target" ]; then
+    echo "target already exists: $target" >&2
+    exit 1
+  fi
+  git worktree add "$target" "$tag"
+  (
+    cd "$target"
+    for patch in $PATCH_FILES; do
+      echo "applying $patch"
+      git apply --3way "$ROOT/$patch"
+    done
+  ) || {
+    echo "patch apply needs manual conflict resolution in: $target" >&2
+    exit 1
+  }
+  echo "created: $target"
+  if [ "${COPY_TOOLING:-1}" = "1" ]; then
+    echo "==> copying product layer"
+    cmd_tooling "$target"
+  fi
+  echo "next: $0 check $target"
+}
+
+case "${1:-status}" in
+  status) cmd_status ;;
+  export) cmd_export ;;
+  verify-patch) cmd_verify_patch "${2:-}" ;;
+  tooling) cmd_tooling "${2:-}" ;;
+  check) cmd_check "${2:-$ROOT}" ;;
+  check-full) cmd_check_full "${2:-$ROOT}" ;;
+  apply) cmd_apply "${2:-}" ;;
+  *)
+    echo "usage: $0 {status|export|verify-patch [file]|tooling <dir>|check [dir]|check-full [dir]|apply <tag>}" >&2
+    echo "  PATCH_FILES overrides the patch list (default: main series)" >&2
+    echo "  COPY_TOOLING=0 skips copying the product layer into a new worktree" >&2
+    exit 2
+    ;;
+esac
diff --git a/scripts/verify-channel-types.mjs b/scripts/verify-channel-types.mjs
new file mode 100644
index 000000000..7ff436c00
--- /dev/null
+++ b/scripts/verify-channel-types.mjs
@@ -0,0 +1,249 @@
+// Per-upstream-type console adaptation check.
+// For every channel type we wire, verify that the panel can create/update the
+// channel with daily_token_limit set, that the value survives the update path,
+// and that our field never changes the type's own validation result.
+// Usage: node scripts/verify-channel-types.mjs [base_url]
+const BASE = process.argv[2] || 'http://localhost:3800';
+const ADMIN_USER = process.env.NEW_API_ADMIN_USER || 'root';
+const ADMIN_PASS = process.env.NEW_API_ADMIN_PASS || 'rootpass123';
+const MOCK_BASE = 'http://host.docker.internal:3999';
+
+// type id -> label; includes every upstream this product uses.
+const TYPES = [
+  [1, 'OpenAI'],
+  [14, 'Anthropic'],
+  [16, 'Zhipu'],
+  [17, 'Ali'],
+  [24, 'Gemini'],
+  [25, 'Moonshot'],
+  [41, 'VertexAI'],
+  [43, 'DeepSeek'],
+  [45, 'VolcEngine'],
+  [54, 'Doubao'],
+  [57, 'Codex'],
+  [58, 'AdvancedCustom'],
+  [59, 'Sub2API'],
+  [60, 'NewAPI'],
+  [61, 'TaskPlugin'],
+  [62, 'VLLM'],
+  [63, 'SGLang'],
+];
+
+// Type-specific required config, so these upstreams are tested with a channel
+// the console actually accepts.
+const TYPE_EXTRA = {
+  58: {
+    settings: JSON.stringify({
+      advanced_custom: {
+        advanced_routes: [
+          {
+            incoming_path: '/v1/chat/completions',
+            upstream_path: '/v1/chat/completions',
+            converter: '',
+            models: [`verify-m-58`],
+          },
+        ],
+      },
+    }),
+  },
+  // Type 61 shares the same setting JSON as daily_token_limit, so it is the
+  // collision risk to prove. "alibaba" is the plugin this build registers.
+  61: { taskPluginKey: 'alibaba' },
+};
+
+const jar = new Map();
+let accessToken = '';
+let adminId = '';
+const rows = [];
+
+async function api(path, { method = 'GET', body } = {}) {
+  const res = await fetch(`${BASE}${path}`, {
+    method,
+    headers: {
+      'content-type': 'application/json',
+      ...(accessToken ? { authorization: `Bearer ${accessToken}`, 'new-api-user': adminId } : {}),
+      ...(jar.size ? { cookie: [...jar.entries()].map(([k, v]) => `${k}=${v}`).join('; ') } : {}),
+    },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  for (const pair of res.headers.getSetCookie?.() || []) {
+    const [k, ...rest] = pair.split('=');
+    jar.set(k.trim(), rest.join('=').split(';')[0]);
+  }
+  const text = await res.text();
+  try {
+    return { status: res.status, json: JSON.parse(text) };
+  } catch {
+    return { status: res.status, json: { raw: text.slice(0, 160) } };
+  }
+}
+
+async function listChannels() {
+  const res = await api('/api/channel/');
+  return Array.isArray(res.json.data) ? res.json.data : res.json.data?.items || [];
+}
+
+async function createChannel(name, type, setting) {
+  const extra = TYPE_EXTRA[type] || {};
+  let mergedSetting = setting;
+  if (extra.taskPluginKey) {
+    const parsed = JSON.parse(setting || '{}');
+    parsed.task_plugin_key = extra.taskPluginKey;
+    mergedSetting = JSON.stringify(parsed);
+  }
+  const body = {
+    mode: 'single',
+    channel: {
+      name,
+      type,
+      base_url: MOCK_BASE,
+      key: 'mock-key',
+      models: `verify-m-${type}`,
+      group: 'default',
+      priority: 0,
+      weight: 0,
+      status: 1,
+      setting: mergedSetting,
+      ...(extra.settings ? { settings: extra.settings } : {}),
+    },
+  };
+  const res = await api('/api/channel/', { method: 'POST', body });
+  if (res.json.success !== true) {
+    return { ok: false, message: String(res.json.message || res.json.error || '').slice(0, 90) };
+  }
+  const found = (await listChannels()).find((c) => c.name === name) || null;
+  return { ok: true, channel: found };
+}
+
+function hasLimit(channel) {
+  try {
+    return Number(JSON.parse(channel.setting || '{}').daily_token_limit) === 10;
+  } catch {
+    return false;
+  }
+}
+
+async function main() {
+  const login = await api('/api/user/login', { method: 'POST', body: { username: ADMIN_USER, password: ADMIN_PASS } });
+  accessToken = login.json.data?.access_token || '';
+  adminId = String(login.json.data?.user?.id || '');
+  if (!accessToken) {
+    console.error('login failed:', JSON.stringify(login.json).slice(0, 160));
+    process.exit(1);
+  }
+  await api('/api/option/', {
+    method: 'PUT',
+    body: {
+      key: 'ModelPrice',
+      value: JSON.stringify(Object.fromEntries(TYPES.map(([t]) => [`verify-m-${t}`, 0.01]))),
+    },
+  });
+
+  const limited = [];
+  for (const [type, label] of TYPES) {
+    const baseName = `verify-type-${type}`;
+    const plainName = `${baseName}-plain`;
+    const limitName = `${baseName}-limit`;
+
+    // Baseline without our field, so a type-specific rejection is not blamed on the patch.
+    const plain = await createChannel(plainName, type, '{}');
+    const withLimit = await createChannel(limitName, type, JSON.stringify({ daily_token_limit: 10 }));
+
+    if (plain.ok !== withLimit.ok) {
+      rows.push({ type, label, result: 'DIFFERS', detail: `plain=${plain.ok} limit=${withLimit.ok} ${withLimit.message || plain.message}` });
+    } else if (!withLimit.ok) {
+      rows.push({ type, label, result: 'skipped', detail: `type needs extra config: ${withLimit.message}` });
+    } else {
+      const saved = hasLimit(withLimit.channel);
+      // Update an unrelated field through the panel API and re-read.
+      await api('/api/channel/', { method: 'PUT', body: { id: withLimit.channel.id, weight: 5 } });
+      const after = (await listChannels()).find((c) => c.id === withLimit.channel.id);
+      const survived = after ? hasLimit(after) : false;
+      let detail = `create=${saved} after-update=${survived}`;
+      let pairOk = true;
+      if (TYPE_EXTRA[type]?.taskPluginKey && after) {
+        const parsed = JSON.parse(after.setting || '{}');
+        pairOk = parsed.task_plugin_key === TYPE_EXTRA[type].taskPluginKey && Number(parsed.daily_token_limit) === 10;
+        detail += ` plugin-key-preserved=${pairOk}`;
+      }
+      rows.push({
+        type,
+        label,
+        result: saved && survived && pairOk ? 'ok' : 'BROKEN',
+        detail,
+      });
+      if (saved && survived && pairOk) limited.push({ id: withLimit.channel.id, type, label });
+    }
+    if (plain.channel) await api(`/api/channel/${plain.channel.id}`, { method: 'DELETE' });
+    if (withLimit.channel && !(rows.at(-1).result === 'ok')) {
+      await api(`/api/channel/${withLimit.channel.id}`, { method: 'DELETE' });
+    }
+  }
+
+  console.log('type | label | result | detail');
+  for (const r of rows) console.log(`${String(r.type).padStart(4)} | ${r.label.padEnd(14)} | ${r.result.padEnd(7)} | ${r.detail}`);
+
+  const broken = rows.filter((r) => r.result === 'BROKEN' || r.result === 'DIFFERS');
+  console.log(
+    `\n${rows.length - broken.length}/${rows.length} types adapted (${limited.length} kept for the cap test)`
+  );
+
+  // Per type: the channel must be routable at all, then blocked once its daily
+  // cap is reached. Each channel owns a unique model, so selection is exact.
+  if (limited.length) {
+    const { execFileSync } = await import('node:child_process');
+    const container = process.env.POC_POSTGRES_CONTAINER || 'new-api-poc-postgres';
+    const raw = execFileSync(
+      'docker',
+      ['exec', container, 'psql', '-U', 'newapi', '-d', 'new-api', '-tAc', "select key from tokens where name = 'verify-daily-limit' order by id desc limit 1"],
+      { encoding: 'utf8' },
+    ).trim();
+    const apiKey = raw.startsWith('sk-') ? raw.slice(3) : raw;
+    if (!apiKey) {
+      console.error('no plaintext token key; run scripts/verify-daily-limit.mjs first');
+      process.exit(1);
+    }
+    await new Promise((r) => setTimeout(r, 7000));
+
+    const call = async (type) => {
+      const res = await fetch(`${BASE}/v1/chat/completions`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json', authorization: `Bearer sk-${apiKey}` },
+        body: JSON.stringify({ model: `verify-m-${type}`, messages: [{ role: 'user', content: 'x' }] }),
+      });
+      return { status: res.status, body: (await res.text()).slice(0, 200) };
+    };
+
+    console.log('\ntype | label | routable | capped');
+    let capFails = 0;
+    for (const ch of limited) {
+      const first = await call(ch.type);
+      // Usage is written during settlement, after the response is flushed.
+      await new Promise((r) => setTimeout(r, 2000));
+      const second = await call(ch.type);
+      const blocked = second.status === 429 && /daily_token_limit_exceeded/.test(second.body);
+      if (first.status !== 200) {
+        // The mock upstream does not implement every provider's path shape;
+        // that is a harness gap, not a gateway defect.
+        console.log(
+          `${String(ch.type).padStart(4)} | ${ch.label.padEnd(14)} | ${first.status} (mock upstream path not implemented, cap not asserted)`
+        );
+      } else {
+        if (!blocked) capFails += 1;
+        console.log(
+          `${String(ch.type).padStart(4)} | ${ch.label.padEnd(14)} | ${first.status} | ${second.status}${blocked ? ' (429 daily)' : ` body=${second.body.slice(0, 70)}`}`
+        );
+      }
+      await api(`/api/channel/${ch.id}`, { method: 'DELETE' });
+    }
+    console.log(`\ncap enforcement: ${limited.length - capFails}/${limited.length} types`);
+    if (capFails) process.exit(1);
+  }
+
+  process.exit(broken.length ? 1 : 0);
+}
+
+main().catch((err) => {
+  console.error('error:', err.message);
+  process.exit(1);
+});
