# Product image built by scripts/build-image.sh
# For a quick PoC without the daily-limit patch, set:
#   NEW_API_IMAGE=calciumion/new-api:latest
NEW_API_IMAGE=new-api-daily-limit:local
NEW_API_BIND_HOST=0.0.0.0
NEW_API_PORT=3800

# Keep the OAuth management UI local by default.
# Set 0.0.0.0 only behind an authenticated reverse proxy.
AICLIENT2API_BIND_HOST=127.0.0.1
AICLIENT2API_IMAGE=justlikemaki/aiclient-2-api:latest
# Reproducible pin snapshot (2026-10-24):
# AICLIENT2API_IMAGE=justlikemaki/aiclient-2-api@sha256:cdf272ff8f6f70fea9b985d7f84a236a0eeb73e9049bac634480a68ef998e198
AICLIENT2API_PORT=3100

# Change these before deploying anywhere.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
SESSION_SECRET=change-me

# Credentials the verification harnesses and the channel importer use to log in.
# The repo keeps no default password (a committed fallback both trips secret
# scanners and lets a script log in to the wrong stack silently), so the harnesses
# exit with instructions when this is missing. Set it to whatever you entered at
# /setup, then load it before running them:
#   set -a; . ./.env; set +a
#   node scripts/verify-daily-limit.mjs
NEW_API_ADMIN_USER=root
NEW_API_ADMIN_PASS=change-me
