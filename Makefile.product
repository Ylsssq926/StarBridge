# Product entry points. Run from the repository root.
IMAGE ?= new-api-daily-limit:local
COMPOSE_ENV ?= .env
COMPOSE_FILE ?= docker-compose.poc.yml

.PHONY: image up down logs ps sync-status sync-check sync-check-full drill

image:
	./scripts/build-image.sh

up:
	docker compose --env-file $(COMPOSE_ENV) -f $(COMPOSE_FILE) up -d

down:
	docker compose --env-file $(COMPOSE_ENV) -f $(COMPOSE_FILE) down

logs:
	docker compose --env-file $(COMPOSE_ENV) -f $(COMPOSE_FILE) logs -f new-api

ps:
	docker compose --env-file $(COMPOSE_ENV) -f $(COMPOSE_FILE) ps

sync-status:
	./scripts/upstream-sync.sh status

sync-check:
	./scripts/upstream-sync.sh check

sync-check-full:
	./scripts/upstream-sync.sh check-full

# Monthly upstream follow-up: make drill REF=upstream/main
drill:
	@if [ -z "$(REF)" ]; then echo "usage: make drill REF=<upstream ref>" >&2; exit 2; fi
	./scripts/upstream-sync.sh drill $(REF)
